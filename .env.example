# Steam Web API 키 (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=여기에_키를_입력하세요

# collie 서버가 읽는 LLM 자격증명. 해석 순서: 요청 키 > process.env > 서버 실행 디렉터리의 .env > ~/.config/questail/.env.
# 컨테이너·CI에서는 파일 대신 같은 세 변수를 환경변수로 넣을 수 있다.
# 세 값(키·BASE_URL·모델명)은 한 세트로 같은 제공자를 가리켜야 한다. 어긋나면(키는 외부 제공자인데 BASE_URL은 로컬 등)
# 생성 답변이 나오지 않고 검색 결과만 나온다. 아래 A/B 중 쓰는 쪽 하나만 남기고 나머지는 지운다.
#
# A. 로컬 Ollama를 쓰는 경우. 로컬은 키를 검사하지 않으므로 키란은 아무 문자열이나 넣는다 (서버는 키 존재 여부만 본다).
# 모델은 미리 받아둬야 한다. 예: ollama pull qwen3:8b
QUESTAIL_LLM_API_KEY=ollama
QUESTAIL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# MODEL은 사실상 필수다. 비워두거나 존재하지 않는 모델명을 넣으면 생성 답변이 나오지 않고 검색 결과만 나온다.
QUESTAIL_LLM_MODEL=qwen3:8b
#
# B. 외부 제공자를 쓰는 경우. 세 값을 같은 제공자의 것으로 채운다.
# QUESTAIL_LLM_API_KEY=여기에_키를_입력하세요
# QUESTAIL_LLM_BASE_URL=https://api.openai.com/v1
# QUESTAIL_LLM_MODEL=여기에_모델명을_입력하세요
