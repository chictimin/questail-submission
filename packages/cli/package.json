  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@questail/collie": "workspace:*",
    "@questail/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
