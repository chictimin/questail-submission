{
  "name": "@questail/cli",
  "version": "0.1.0",
  "private": true,
  "description": "QuestTail CLI — questail bin wrapper over @questail/core",
  "license": "MIT",
  "type": "module",
  "bin": {
    "questail": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
