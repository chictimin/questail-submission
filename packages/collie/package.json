  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@questail/core": "workspace:*",
    "@langchain/langgraph": "^1.4.16",
    "@hono/node-server": "2.1.1",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
