{
  "name": "@questail/collie",
  "version": "0.1.0",
  "private": true,
  "description": "QuestTail GraphRAG app layer",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "config",
    "dist",
    "demo-corpus",
    "LICENSE"
